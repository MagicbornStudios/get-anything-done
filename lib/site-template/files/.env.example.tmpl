# ── Site: {{slug}} ──────────────────────────────────────────────────────────
# Copy to .env.local and fill values. Never commit .env.local.
#
# Placeholder convention: `<your-...-here>` means "replace before use."
# Empty values mean "graceful degradation OK; feature disables until set."

# -----------------------------------------------------------------------------
# [AI] Vercel AI Gateway — required for any /api/ai/* or agent route.
# -----------------------------------------------------------------------------
# In Vercel deploys, AI_GATEWAY_API_KEY is auto-provisioned via OIDC —
# leave unset there. For local dev: `vercel env pull` OR set manually.
AI_GATEWAY_API_KEY=<your-ai-gateway-key-here>

# Direct Anthropic fallback (only used if AI Gateway unset).
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# [AUTH] Clerk — optional, falls back to anonymous browsing if blank.
# -----------------------------------------------------------------------------
# Get keys from https://dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key-here>
CLERK_SECRET_KEY=<your-clerk-secret-key-here>

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# -----------------------------------------------------------------------------
# [DATA] Supabase — optional, leave blank if not using Supabase.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# [SITE] Public origin (used for absolute URLs, OG tags, sitemaps).
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://{{slug}}.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
