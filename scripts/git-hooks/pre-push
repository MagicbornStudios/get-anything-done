#!/usr/bin/env sh
# scripts/git-hooks/pre-push
#
# POSIX sh dispatcher that locates `node` (handles Git for Windows where the
# hook environment's PATH excludes the Program Files\nodejs directory) and
# invokes the real Node implementation at scripts/git-hooks/pre-push.cjs.
#
# Why this exists: git hooks on Windows run under a stripped PATH and
# `#!/usr/bin/env node` fails with "env: 'node': No such file or directory"
# even though `node` is on the user's shell PATH. POSIX sh + explicit lookup
# fixes it without a Node-shebang dependency.
#
# All real logic lives in pre-push.cjs.

set -eu

# Find a usable node. Order: PATH (which), common Windows install dirs.
NODE_BIN=""
if command -v node >/dev/null 2>&1; then
  NODE_BIN=node
elif command -v node.exe >/dev/null 2>&1; then
  NODE_BIN=node.exe
elif [ -x "/c/Program Files/nodejs/node.exe" ]; then
  NODE_BIN="/c/Program Files/nodejs/node.exe"
elif [ -x "$LOCALAPPDATA/Programs/nodejs/node.exe" ]; then
  NODE_BIN="$LOCALAPPDATA/Programs/nodejs/node.exe"
elif [ -x "/c/Program Files (x86)/nodejs/node.exe" ]; then
  NODE_BIN="/c/Program Files (x86)/nodejs/node.exe"
fi

if [ -z "$NODE_BIN" ]; then
  echo "[repo-hygiene] node not found on PATH — cannot run pre-push checks." >&2
  echo "[repo-hygiene] Install node 18+ OR set --no-verify to bypass." >&2
  exit 1
fi

HERE=$(cd "$(dirname "$0")" && pwd)

# Resolve symlinks so we find pre-push.cjs alongside the real script even
# when the hook is invoked via a symlink in .git/hooks/.
RESOLVED="$0"
if [ -L "$RESOLVED" ]; then
  if command -v readlink >/dev/null 2>&1; then
    LINK=$(readlink "$RESOLVED" 2>/dev/null || true)
    if [ -n "$LINK" ]; then
      case "$LINK" in
        /*|[A-Za-z]:/*|[A-Za-z]:\\*) RESOLVED="$LINK" ;;
        *) RESOLVED="$(dirname "$0")/$LINK" ;;
      esac
    fi
  fi
fi
SCRIPT_DIR=$(cd "$(dirname "$RESOLVED")" && pwd)

CJS="$SCRIPT_DIR/pre-push.cjs"
if [ ! -f "$CJS" ]; then
  # Fall back to HERE — handles the no-symlink case.
  CJS="$HERE/pre-push.cjs"
fi
if [ ! -f "$CJS" ]; then
  echo "[repo-hygiene] pre-push.cjs not found near hook ($SCRIPT_DIR or $HERE)." >&2
  exit 1
fi

exec "$NODE_BIN" "$CJS" "$@"
